{
  "redirects": [
    { "source": "/", "destination": "/index.html", "statusCode": 200 },
    { "source": "/auth", "destination": "/auth.html", "statusCode": 200 },
    { "source": "/onboarding", "destination": "/onboarding.html", "statusCode": 200 },
    { "source": "/dashboard", "destination": "/dashboard.html", "statusCode": 200 },
    { "source": "/agent/:slug", "destination": "/agent.html", "statusCode": 200 },
    { "source": "/demo", "destination": "/demo.html", "statusCode": 200 },
    { "source": "/demo/abbie", "destination": "/demo.html", "statusCode": 200 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "origin-when-cross-origin" }
      ]
    }
  ]
}